{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Floppy Workbench",
  "version": "0.1.0",
  "identifier": "com.floppyformatte.manager",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Floppy Workbench",
        "width": 960,
        "height": 680,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "decorations": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Floppy Workbench",
    "category": "Utility",
    "shortDescription": "USB floppy emulator manager",
    "longDescription": "Format and manage USB sticks for SFR1M44 / Alfais 4408 USB floppy emulators: FAT12 floppy banks, file explorer, FreeDOS boot disks, backup.",
    "copyright": "MIT License (bundled FreeDOS files: GPL)",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "installMode": "perMachine" }
    }
  }
}
